#!/bin/sh
# Launch tam-pane 0.1.12 nested under Hyprland to show that a program
# that starts fullscreen opens fullscreen (R1 finding 4).
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

want=$(tr -d '[:space:]' < "$ROOT/VERSION")
have=$("$ROOT/build/tam-pane" -v 2>/dev/null | awk '{print $2}') || true
if [ "$have" != "$want" ]; then
	echo "build/tam-pane is '${have:-missing}', VERSION is $want: run make first" >&2
	exit 1
fi

TMPDIR_DEMO=$(mktemp -d "${TMPDIR:-/tmp}/tam-pane-demo-0.1.12.XXXXXX")
trap 'rm -rf "$TMPDIR_DEMO"' EXIT INT TERM

CFG="$TMPDIR_DEMO/init.lua"
GUIDE="$TMPDIR_DEMO/guide"
LOG="$TMPDIR_DEMO/log"
{
	printf 'local GUIDE = "%s"\n' "$GUIDE"
	cat "$ROOT/sandbox/demo-0.1.12.lua"
} >"$CFG"

cat >"$GUIDE" <<'GUIDE'
=== tam-pane 0.1.12 demo: programs that start fullscreen ===

 1. Press Meta+O. A terminal started with foot --fullscreen opens and
    fills the whole nested window. Before 0.1.12 it opened tiled.
 2. Press Meta+F: it leaves fullscreen and tiles beside this guide.
    Type exit in it to close it.
 3. Press Meta+Shift+E to quit. The launcher prints PASS or FAIL.

GUIDE

"$ROOT/tools/nested-input" -c "$CFG" -s '' 2>&1 | tee "$LOG" || true

echo
ok=$(grep -c '\[demo\] ok:' "$LOG" || true)
bad=$(grep -c '\[demo\] FAIL:' "$LOG" || true)
if [ "$bad" -eq 0 ] && [ "$ok" -ge 1 ]; then
	echo "PASS: the terminal opened fullscreen"
else
	echo "FAIL: $bad of $((ok + bad)) fullscreen terminals opened tiled"
	echo "      (or Meta+O was not pressed)"
	exit 1
fi

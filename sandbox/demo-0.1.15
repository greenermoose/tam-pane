#!/bin/sh
# Launch tam-pane 0.1.15 nested under Hyprland to show that a menu opened
# near the screen edge stays on screen, also after the program moves it
# (B7), in Files, a GTK 4 program that stays open (B6). Both are seen, not
# logged, so this demo asks instead of printing PASS or FAIL itself. It
# prints tam-pane's popup placement lines afterwards as evidence.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

want=$(tr -d '[:space:]' < "$ROOT/VERSION")
have=$("$ROOT/build/tam-pane" -v 2>/dev/null | awk '{print $2}') || true
if [ "$have" != "$want" ]; then
	echo "build/tam-pane is '${have:-missing}', VERSION is $want: run make first" >&2
	exit 1
fi
if ! command -v nautilus >/dev/null 2>&1; then
	echo "this demo needs nautilus (Files) for its right-click menu" >&2
	exit 1
fi

TMPDIR_DEMO=$(mktemp -d "${TMPDIR:-/tmp}/tam-pane-demo-0.1.15.XXXXXX")
trap 'rm -rf "$TMPDIR_DEMO"' EXIT INT TERM

CFG="$TMPDIR_DEMO/init.lua"
GUIDE="$TMPDIR_DEMO/guide"
LOG="$TMPDIR_DEMO/log"
{
	printf 'local GUIDE = "%s"\n' "$GUIDE"
	cat "$ROOT/sandbox/demo-0.1.15.lua"
} >"$CFG"

cat >"$GUIDE" <<'GUIDE'
=== tam-pane 0.1.15 demo: menus near the edge stay on screen ===

 1. Put the pointer on the right half of this guide window, then press
    Meta+O. Files opens on the right (a new window goes on the side
    the pointer is on); it may take a few seconds, and it stays open.
 2. In Files, right-click an empty spot close to the bottom-right
    corner of the nested window. The menu should open up and to the
    left, wholly inside the nested window. In 0.1.14 it ran off the
    edge.
 3. Press Escape, close Files, then press Meta+Shift+E to quit, and
    answer the launcher's question.

GUIDE

"$ROOT/tools/nested-input" -c "$CFG" -s '' 2>&1 | tee "$LOG" || true

echo
echo "tam-pane's popup placements (box = the monitor, in the window's"
echo "coordinates; placed = where the menu went):"
if grep -q 'popup on' "$LOG"; then
	grep 'popup on' "$LOG" | sed 's/^/  /'
else
	echo "  none logged"
fi
echo
printf 'Did Files stay open, and the menu stay inside the window? [y/n] '
read -r answer
case $answer in
y | Y | yes) echo "PASS: Files stayed open and the menu stayed on screen" ;;
*) echo "FAIL: Files closed, or the menu ran off the edge"; exit 1 ;;
esac
